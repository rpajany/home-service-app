MONGODB_URI=mongodb://127.0.0.1:27017/home-service
JWT_SECRET=replace-this-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (Admin Service image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OAuth / NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0

# =========================================================
# Contact / Book a Service email
# EMAIL_API must be: gmail OR resend
# =========================================================
EMAIL_API=gmail

# Company email. If a Company document has an email, that value is used first.
COMPANY_EMAIL=yourcompany@gmail.com
CONTACT_EMAIL=yourcompany@gmail.com

# =========================================================
# Gmail SMTP
# Use a Google App Password, NOT your normal Gmail password.
# =========================================================
GMAIL_USER=yourcompany@gmail.com
GMAIL_APP_PASSWORD=

# =========================================================
# Resend
# =========================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=
